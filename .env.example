# ==========================================================================
# Portal de Integração — variáveis de ambiente (exemplo)
# Copie para .env.local e preencha. NUNCA commite .env.local nem segredos.
# ==========================================================================

# --- Sessão / Auth ---
AUTH_SECRET=                       # obrigatório: sessão JWT + chave derivada p/ criptografia
AUTH_URL=http://localhost:3002     # URL pública do portal

# --- SSO (login do portal) ---
FUNCIONAL_SSO_GRAPHQL_URL=         # endpoint GraphQL do SSO (login corporativo)

# --- Login de desenvolvimento (LOCAL ONLY, nunca em produção) ---
DEV_AUTH_ENABLED=false             # true habilita login dev sem senha (só em NODE_ENV=development)

# --- IA (camada desenhada desde o dia 1; provedor único no início) ---
AI_PROVIDER=stub                   # stub | openai | anthropic | ... (stub = sem custo, para dev)
AI_API_KEY=                        # chave do provedor (server-side; NUNCA exposta ao browser)
AI_MODEL=                          # modelo padrão
AI_MONTHLY_BUDGET_USD=             # teto de custo mensal p/ alerta (Princípio 8)

# --- Banco de dados (ainda NÃO usado — stateless-first; ver ADR-0002) ---
# DATABASE_URL=                    # descomente quando um módulo transacional exigir banco
