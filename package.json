{
  "name": "portal-integracao",
  "version": "0.1.0",
  "private": true,
  "description": "Portal de Integração modular do time EDI/Tecnologia — documentação viva, homologação e automações com IA.",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "arch": "depcruise app core modules --config .dependency-cruiser.cjs",
    "arch:graph": "depcruise app core modules --config .dependency-cruiser.cjs --output-type dot > architecture.dot",
    "ci": "npm run typecheck && npm run lint && npm run arch && npm run test && npm run build"
  },
  "dependencies": {
    "next": "14.2.28",
    "next-auth": "^5.0.0-beta.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.28",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
